# An anti-join entry (NOT IN or NOT EXISTS) keeps set semantics unless it already has a node of its
# own, so its base table never reaches both sides of one join.
# Every query is served as a cache: with no upstream, a query the planner refuses fails the run.
#
# Each walk loads a few outer and inner rows, then reads after each write: delete a matched inner
# row while the group stays non-empty, insert a NULL (except o_pp, whose columns are NOT NULL),
# delete it, duplicate a matched value and delete one copy (the matched outer row stays excluded
# while one copy remains), and insert an unmatched outer row. The order of these steps varies
# between walks.
#
# o_qa/i_qa: one NOT IN over a nullable inner column, read only by its own null-present probe.
# o_b/i_b: two NOT INs over the same nullable column.
# o_nn/i_nn: two NOT INs over one table, one with a NOT NULL left side and a NOT NULL inner column,
#   so its probe is elided; the other has a nullable inner column. Also a two-row insert.
# o_ne/i_ne: a NOT EXISTS entry, which has no guard of its own, beside a NOT IN over the same table.
# o_pp/i_pp: two NOT INs with NOT NULL on both sides over one table, so no probe reads it and each
#   entry is read by the other. Also a three-row insert that duplicates a matched value.

statement ok
create table o_qa (id int primary key, k int not null, n int);

statement ok
create table i_qa (id int primary key, v int, w int not null);

statement ok
insert into o_qa (id, k, n) values (1, 1, 5), (2, 2, 10), (3, 3, 20), (4, 5, 7);

statement ok
insert into i_qa (id, v, w) values (1, 1, 1), (2, 2, 2), (3, 7, 3);

query I nosort
SELECT o_qa.id FROM o_qa WHERE o_qa.k NOT IN (SELECT i_qa.v FROM i_qa) ORDER BY o_qa.id;
----
3
4

statement ok
delete from i_qa where id = 1;

