# A row already in the base moves into the filter for a key that is cached
statement ok
UPDATE items SET status = 'b' WHERE id = 13

query I rowsort
SELECT id FROM items WHERE owner = 2 AND kind = 2 AND (status = 'a' OR status = 'b')
----
10
13
5
6
7
