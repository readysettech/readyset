# Caches on a base table followed by a filter node with constants, so a replay reads the table by
# those constants. Constants in an OR stay in the filter node when a cache is parameterized. Each
# cache's first read replays from the table. The writes then move rows into and out of each filter,
# and the reads after them check that the caches still return the right rows.

statement ok
CREATE TABLE items (id int PRIMARY KEY, owner int, kind int, status text, sort_key int)

statement ok
CREATE TABLE listed (id int PRIMARY KEY, show_id int, item_id int, state int)

statement ok
INSERT INTO items VALUES
(1, 1, 2, 'a', 10),
(2, 1, 2, 'b', 20),
(3, 1, 2, 'c', 30),
(4, 1, 3, 'a', 40),
(5, 1, 2, 'a', 5),
(6, 2, 2, 'a', 60),
(7, 2, 2, 'b', 70),
(8, 3, 2, 'a', 80),
(9, 4, 2, 'c', 90),
(10, 4, 2, 'b', 95)

statement ok
INSERT INTO listed VALUES
(1, 100, 1, 1),
(2, 100, 2, 1),
(3, 100, 3, 1),
(4, 100, 4, 1),
(5, 100, 5, 0),
(6, 200, 6, 1),
(7, 200, 7, 1),
(8, 300, 8, 1),
(9, 400, 9, 1),
(10, 400, 10, 1)

onlyif readyset
statement ok
CREATE CACHE point FROM SELECT id FROM items WHERE owner = ? AND kind = 2 AND (status = 'a' OR status = 'b')

onlyif readyset
statement ok
CREATE CACHE ranged FROM SELECT id FROM items WHERE owner = ? AND kind = 2 AND (status = 'a' OR status = 'b') AND sort_key > ? ORDER BY sort_key LIMIT 2

# Its constants stay as written, so each replay reads the table by several of them at once
onlyif readyset
statement ok
CREATE CACHE joined WITH (AUTOPARAM OFF) FROM SELECT items.id FROM items JOIN listed ON listed.item_id = items.id WHERE listed.show_id = ? AND listed.state = 1 AND items.owner = ? AND items.kind = 2 AND items.status IN ('a', 'b') AND items.sort_key > ? ORDER BY items.sort_key LIMIT 3

onlyif readyset
statement ok
CREATE CACHE below FROM SELECT id FROM items WHERE owner = ? AND kind = 2 AND (status = 'a' OR status = 'b') AND sort_key < ? ORDER BY sort_key DESC LIMIT 2

onlyif readyset
statement ok
CREATE CACHE spanned FROM SELECT id FROM items WHERE owner = ? AND kind = 2 AND (status = 'a' OR status = 'b') AND sort_key >= ? AND sort_key <= ?

query I rowsort
SELECT id FROM items WHERE owner = 1 AND kind = 2 AND (status = 'a' OR status = 'b')
----
1
2
5

query I nosort
SELECT id FROM items WHERE owner = 1 AND kind = 2 AND (status = 'a' OR status = 'b') AND sort_key > 7 ORDER BY sort_key LIMIT 2
----
1
2

query I nosort
SELECT items.id FROM items JOIN listed ON listed.item_id = items.id WHERE listed.show_id = 100 AND listed.state = 1 AND items.owner = 1 AND items.kind = 2 AND items.status IN ('a', 'b') AND items.sort_key > 0 ORDER BY items.sort_key LIMIT 3
----
1
2

query I nosort
SELECT id FROM items WHERE owner = 1 AND kind = 2 AND (status = 'a' OR status = 'b') AND sort_key < 15 ORDER BY sort_key DESC LIMIT 2
----
1
5

query I rowsort
SELECT id FROM items WHERE owner = 1 AND kind = 2 AND (status = 'a' OR status = 'b') AND sort_key >= 5 AND sort_key <= 20
----
1
2
5

# Rows move into the filter (3 by status, 4 by kind), out of it (1), and between owners (5 to
# owner 2, 10 from owner 4), and are inserted and deleted
statement ok
UPDATE items SET status = 'a' WHERE id = 3

statement ok
UPDATE items SET kind = 2 WHERE id = 4

statement ok
UPDATE items SET status = 'c' WHERE id = 1

statement ok
UPDATE items SET owner = 2 WHERE id = 5

statement ok
UPDATE items SET owner = 2 WHERE id = 10

statement ok
INSERT INTO items VALUES (11, 1, 2, 'b', 15), (12, 2, 3, 'a', 65), (13, 2, 2, 'd', 66)

statement ok
INSERT INTO listed VALUES (11, 100, 11, 1), (12, 200, 12, 1), (13, 200, 13, 1), (14, 200, 10, 1)

statement ok
DELETE FROM items WHERE id = 2

