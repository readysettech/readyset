statement ok
create table hub (city text, tier int);

statement ok
insert into hub values
('NYC', 1),
('LA',  2),
('SF',  9);

# Rows in s per city: NYC=2, LA=3, SF=1.  Rows in j per city: NYC=3, LA=1.

# Correlated EXISTS in INNER JOIN ON.  Move to WHERE, decorrelate via
# existing WHERE-position machinery.  Only s rows whose city has at least
# one matching j row are kept; equi-join on city aligns the rest.
query IT rowsort
select s.sn, s.city
from s
inner join j on s.city = j.city
             and exists (select 1 from j as j2 where j2.city = s.city);
----
1
NYC
1
NYC
1
NYC
2
NYC
2
NYC
2
NYC
3
LA
4
LA
5
LA

# Uncorrelated IN-subquery in INNER JOIN ON.  Subquery is a query-level
# constant.  The move-to-WHERE + standard IN decorrelation must produce
# results consistent with upstream.  The IN reads `hub`, so its decorrelated
# semi-join compares hub.city to j.city.  An IN over `j` would compare j.city
# to itself, which the engine declines.  `tier <= 1` selects NYC, the same set
# the join sees either way.
query IT rowsort
select s.sn, s.city
from s
inner join j on s.city = j.city
             and j.city in (select city from hub as h where h.tier <= 1);
----
1
NYC
1
NYC
1
NYC
2
NYC
2
NYC
2
NYC

# The shape the query above used to have: the IN reads `j`, which the outer FROM already
# joins, so the decorrelated semi-join compares j.city to itself and the engine declines.
# Kept so that restoring a cache for this shape has to be deliberate.
query IT rowsort error: Self-joins using the same column are unsupported
select s.sn, s.city
from s
inner join j on s.city = j.city
             and j.city in (select city from j as j3 where j3.jn <= 3);
----

# Scalar-subquery comparison in INNER JOIN ON.  Compare a joined column
# to a per-query scalar (max threshold from cfg = 20).  Only s rows
# with status < 20 qualify: sn=1 (status=10), sn=3 (status=15).
query IT rowsort
select s.sn, s.city
from s
inner join j on s.city = j.city
             and s.status < (select max(threshold) from cfg);
----
1
NYC
1
NYC
1
NYC
3
LA

# Subquery predicate is the ONLY ON conjunct — ON becomes empty
# post-move.  Joins as a CROSS JOIN filtered by WHERE.  Small tables:
# 6 s rows x 4 j rows = 24 combos, filtered by EXISTS.  All s rows
# qualify since every city has a matching j row (NYC or LA — SF has
# no j match so excluded).
query IT rowsort
select s.sn, j.city
from s
inner join j on exists (select 1 from j as j2 where j2.city = s.city);
