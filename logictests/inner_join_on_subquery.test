# Multiple INNER JOINs, each with a subquery in ON.  Both move to WHERE
# independently; both equi-joins stay in their respective ONs.
# min(threshold from cfg) = min(20, 5) = 5.  All s rows qualify since
# their status values are all >= 5.
query IT rowsort
select s.sn, s.city
from s
inner join j on s.city = j.city
             and exists (select 1 from j as j2 where j2.city = s.city)
inner join cfg on cfg.k = 'active'
              and s.status >= (select min(threshold) from cfg as cfg2);
----
1
NYC
