# A join keyed twice on the right side's one column: `t1.c1 = t2.c1` and `t1.c2 = t2.c1` both bind
# `t2.c1`, so a lookup into `t2` carries two key entries against a relation with one column. Both
# the inner and the LEFT form are read once the caches are filled, then after each write. `t1.id` is
# there only so the writes below can address a row.

statement ok
CREATE TABLE t1 (id int PRIMARY KEY, c1 int, c2 int)

statement ok
CREATE TABLE t2 (c1 int PRIMARY KEY)

statement ok
INSERT INTO t1 VALUES (1, 1, 1), (2, 2, 5), (3, 3, 3)

statement ok
INSERT INTO t2 VALUES (1), (2)

statement ok
CREATE CACHE FROM SELECT t1.c1, t1.c2, t2.c1 FROM t1 JOIN t2 ON t1.c1 = t2.c1 WHERE t1.c2 = t2.c1

statement ok
CREATE CACHE FROM SELECT t1.c1, t1.c2, t2.c1 FROM t1 LEFT JOIN t2 ON t1.c1 = t2.c1 AND t1.c2 = t2.c1

query III rowsort
SELECT t1.c1, t1.c2, t2.c1 FROM t1 JOIN t2 ON t1.c1 = t2.c1 WHERE t1.c2 = t2.c1
----
1
1
1

query III rowsort
SELECT t1.c1, t1.c2, t2.c1 FROM t1 LEFT JOIN t2 ON t1.c1 = t2.c1 AND t1.c2 = t2.c1
----
1
1
1
2
5
NULL
3
3
NULL

