# A left row stops agreeing with itself: one key column still matches, the other no longer does.
statement ok
UPDATE t1 SET c2 = 1 WHERE id = 3

query III rowsort
SELECT t1.c1, t1.c2, t2.c1 FROM t1 JOIN t2 ON t1.c1 = t2.c1 WHERE t1.c2 = t2.c1
----
2
2
2

