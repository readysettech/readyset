# A NULL operand of AND or OR leaves the result unknown only when the other operand does not
# decide it: NULL AND FALSE is FALSE and NULL OR TRUE is TRUE. The NOT and IS NULL forms are the
# partitions a ternary-logic check compares, so each row lands in exactly one of them.

statement ok
create table t (id int primary key, a int, b int);

statement ok
insert into t (id, a, b) values (1, NULL, 2), (2, NULL, 5), (3, 1, 2), (4, 1, 5);

query I rowsort
SELECT id FROM t WHERE NOT ((a = 1) AND (b = 2));
----
2
4

query I rowsort
SELECT id FROM t WHERE ((a = 1) AND (b = 2)) IS NULL;
----
1

query I rowsort
SELECT id FROM t WHERE (a = 1) OR (b = 2);
----
1
3
4

query I rowsort
SELECT id FROM t WHERE ((a = 1) OR (b = 2)) IS NULL;
----
2
