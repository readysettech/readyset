# An OR in the WHERE clause puts a union above the join, which gives every branch its own replay
# path into the join. All of those paths ask the join for the same straddled key, and each row
# still belongs in the result exactly once.

statement ok
CREATE TABLE t1 (id int PRIMARY KEY, a int, b int, c int)

statement ok
INSERT INTO t1 VALUES (1,1,10,0),(2,1,20,5),(3,1,20,0),(4,1,30,1),(5,2,10,1)

statement ok
CREATE TABLE t2 (id int PRIMARY KEY, t1_id int, k int, m int)

statement ok
INSERT INTO t2 VALUES (1,1,1,1),(2,2,1,1),(3,3,1,1),(4,4,1,1),(5,5,1,1),(6,1,2,1)

# The replay key straddles the join: k and m come from t2, a from t1. Row 1 satisfies the first
# branch of the disjunction and row 2 the second.
query I rowsort
SELECT t1.id
FROM t1
JOIN t2 ON t2.t1_id = t1.id
WHERE t2.k = ?
AND t2.m = ?
AND t1.a = ?
AND (t1.b = 10 OR (t1.b = 20 AND t1.c > 0))
? = 1
? = 1
? = 1
----
1
2

# A row that stops matching leaves the result entirely.
statement ok
UPDATE t1 SET b = 30 WHERE id = 1

query I rowsort
SELECT t1.id
FROM t1
JOIN t2 ON t2.t1_id = t1.id
WHERE t2.k = ?
AND t2.m = ?
AND t1.a = ?
AND (t1.b = 10 OR (t1.b = 20 AND t1.c > 0))
? = 1
? = 1
? = 1
----
2

# Three branches: rows 1 and 4 match the first, row 2 the second, row 3 the third.
query I rowsort
SELECT t1.id
FROM t1
JOIN t2 ON t2.t1_id = t1.id
WHERE t2.k = ?
AND t2.m = ?
AND t1.a = ?
AND (t1.b = 30 OR (t1.b = 20 AND t1.c > 0) OR (t1.b = 20 AND t1.c = 0))
? = 1
? = 1
? = 1
----
1
2
3
4
