# Row comparisons: `(a, b) = (?, ?)` is a lookup, any other comparison of two rows is a
# filter, and a row mixing a placeholder with other operands is unsupported.

statement ok
CREATE TABLE t (id int PRIMARY KEY, a text, b int, c text, d int)

statement ok
INSERT INTO t VALUES (1,'x',1,'x',1),(2,'x',2,'y',2),(3,'y',1,'y',1),(4,'z',3,'q',4),(5,'x',1,'x',2)

# Columns on both sides are compared as a filter.
query I rowsort
SELECT id FROM t WHERE (a, b) = (c, d)
----
1
3

# Non-equality comparisons are filters.
query I rowsort
SELECT id FROM t WHERE (a, b) != ('x', 1)
----
2
3
4

query I rowsort
SELECT id FROM t WHERE (a, b) < ('y', 1)
----
1
2
5

# An all-literal equality is a lookup.
query I rowsort
SELECT id FROM t WHERE (a, b) = ('x', 1)
----
1
5

# A row that stops satisfying the comparison leaves the result.
statement ok
UPDATE t SET d = 9 WHERE id = 3

query I rowsort
SELECT id FROM t WHERE (a, b) = (c, d)
----
1

# Unequal arity is an error.
statement error
SELECT id FROM t WHERE (a, b) != ('x', 1, 'z')

# A partly parameterizable row comparison is not allowed.
statement error
CREATE CACHE row_mixed FROM SELECT id FROM t WHERE (a, b) = ('x', d)

# A prepared row comparison binds one parameter per position.
query I rowsort
SELECT id FROM t WHERE (b, d) = (?, ?)
? = 1
? = 1
----
1

# A literal beside the placeholder is lifted, so the client binds one value and the pass supplies
# the other. The lifted one takes the position after the placeholder, not the placeholder's own.
query I rowsort
SELECT id FROM t WHERE (b, d) = (?, 2)
? = 1
----
5

# A row comparison is scalar at each position: the two operands of every position are converted by
# the ordinary implicit conversion rules, so a numeric-looking string opposite an integer column
# compares as a number. Comparing the rows structurally, without converting, orders any integer
# below any string whatever the values hold.

statement ok
CREATE TABLE tm (id int PRIMARY KEY, a text, b int, c int, e text)

statement ok
INSERT INTO tm VALUES (1,'x',1,1,'1'),(2,'y',2,3,'x'),(3,'1',7,7,'1'),(4,'x',10,5,'y'),(5,'3',4,3,'4')

query I rowsort
SELECT id FROM tm WHERE (a, b) < ('y', '2')
----
1
3
4
5

query I rowsort
SELECT id FROM tm WHERE (a, b) >= ('y', '2')
----
2

# Autoparameterization converts equality alone, so a non-equality comparison keeps its literals and
# they reach the filter with the types they were written with.
query I rowsort
SELECT id FROM tm WHERE (a, b) != ('x', '1')
----
2
3
4
5

# The conversion belongs to the position, so it applies wherever the mismatch falls.
query I rowsort
SELECT id FROM tm WHERE (b, a) < ('2', 'y')
----
1

# Columns on both sides convert the same way.
query I rowsort
SELECT id FROM tm WHERE (a, b) = (c, e)
----
5

# The literals can sit on the left, and each position still resolves against whichever side
# carries the type.
query I rowsort
SELECT id FROM tm WHERE ('y', '2') > (a, b)
----
1
3
4
5

query I rowsort
SELECT id FROM tm WHERE ('y', '2') <= (a, b)
----
2

# A NULL at any position leaves the comparison undecided, so the row stays out of the result.
# Comparing the rows structurally treats two NULLs as equal, which answers a tautology with every
# row and answers its negation with the rows that hold a NULL.

statement ok
CREATE TABLE tn (id int PRIMARY KEY, a int, b int)

statement ok
INSERT INTO tn VALUES (1,5,1),(2,NULL,1),(3,NULL,NULL)

query I rowsort
SELECT id FROM tn WHERE (a, b) != (5, 1)
----

query I rowsort
SELECT id FROM tn WHERE (a, b) = (a, b)
----
1

# A row comparison whose operands hold different numbers of positions, and arithmetic on a row,
# are both errors upstream. A projection reaches the expression without passing the WHERE
# clause's own check, so the lowering has to refuse them itself.
statement error
SELECT (a, b) < (c, d, id) FROM t

statement error
SELECT (a, b) + (c, d) FROM t
