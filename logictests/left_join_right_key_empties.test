# A LEFT join keyed on its left input, whose right input is a partially materialized COUNT. A
# right arrival that empties a filled key swaps the left rows' match for their NULL extension,
# and one that fills it again swaps it back. Each step is read at g = 1, and the last read
# repeats to catch a late duplicate or retraction.

statement ok
CREATE TABLE a (id int PRIMARY KEY, g int, x int)

statement ok
CREATE TABLE b (id int PRIMARY KEY, y int)

statement ok
CREATE CACHE FROM SELECT a.id AS aid, bc.c AS c FROM a LEFT JOIN (SELECT y, count(*) AS c FROM b GROUP BY y) bc ON a.x = bc.y WHERE a.g = ?

statement ok
INSERT INTO a VALUES (1, 1, 2)

query II rowsort
SELECT a.id AS aid, bc.c AS c FROM a LEFT JOIN (SELECT y, count(*) AS c FROM b GROUP BY y) bc ON a.x = bc.y WHERE a.g = ?
? = 1
----
1
NULL

