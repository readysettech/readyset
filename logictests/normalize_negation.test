# Regression: negate_expr must not panic reverting a negated lhs, since negating `NOT x` yields
# a bare `x` that cannot be re-negated.

statement ok
CREATE TABLE t (id INT, a INT, b INT);

statement ok
INSERT INTO t VALUES (1, 0, 0), (2, 0, 1), (3, 1, 0), (4, 1, 1);

query I rowsort
SELECT id FROM t WHERE NOT ((NOT a) AND b);
----
1
3
4
