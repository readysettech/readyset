# PostgreSQL compares two numbers of different types by value, so an INT differs from a BIGINT
# outside INT's range and from a number with a fraction. A row with no NULL operand satisfies
# exactly one of `p` and `NOT (p)`.

statement ok
CREATE TABLE t0 (c0 INT PRIMARY KEY, c1 BIGINT, c2 NUMERIC, c3 DOUBLE PRECISION, c4 REAL);

statement ok
INSERT INTO t0 VALUES (0, 0, 1.5, 1.5, '-0'), (1, -1, 2, 2, 1.5), (2, 5, 2.00, 0.5, 2), (3, -8833812080019883386, NULL, 3, NULL);

query II rowsort
SELECT a0.c1, a1.c0 FROM t0 AS a0 CROSS JOIN t0 AS a1 WHERE ((a0.c0 + 1) = (a1.c1 + 2))
----
-1
0
0
1

query I
SELECT count(*) FROM t0 AS a0 CROSS JOIN t0 AS a1 WHERE (NOT ((a0.c0 + 1) = (a1.c1 + 2)))
----
14

query I rowsort
SELECT c0 FROM t0 WHERE c0 = c2
----
2

query I rowsort
SELECT c0 FROM t0 WHERE c0 = c3
----
3

query I rowsort
SELECT c0 FROM t0 WHERE NOT (c0 = c1)
----
1
2
3

query I rowsort
SELECT c0 FROM t0 WHERE NOT (c0 = c2)
----
0
1

query I rowsort
SELECT c0 FROM t0 WHERE NOT (c0 = c3)
----
0
1
2

query I rowsort
SELECT c0 FROM t0 WHERE c0 = c4
----
0
2

query I rowsort
SELECT c0 FROM t0 WHERE NOT (c0 = c4)
----
1

query I rowsort
SELECT c0 FROM t0 WHERE c0 < c4
----
1

query I rowsort
SELECT c0 FROM t0 WHERE NOT (c0 < c4)
----
0
2

query I rowsort
SELECT c0 FROM t0 WHERE c2 = c3
----
0
1

query I rowsort
SELECT c0 FROM t0 WHERE NOT (c2 = c3)
----
2

query I rowsort
SELECT c0 FROM t0 WHERE c2 > c3
----
2

query I rowsort
SELECT c0 FROM t0 WHERE NOT (c2 > c3)
----
0
1

query I rowsort
SELECT c0 FROM t0 WHERE c2 = c4
----
2

query I rowsort
SELECT c0 FROM t0 WHERE NOT (c2 = c4)
----
0
1

# NaN equals NaN and is greater than every other number, and -0 equals 0. PostgreSQL compares an
# INT or a NUMERIC with a REAL as two DOUBLE PRECISIONs, so 16777217 differs from REAL 16777216.

statement ok
CREATE TABLE t1 (id INT PRIMARY KEY, i INT, n NUMERIC, r REAL, d DOUBLE PRECISION);

statement ok
INSERT INTO t1 VALUES (0, 1, 'Infinity', 'Infinity', 'Infinity'), (1, 1, '-Infinity', '-Infinity', '-Infinity'), (2, 1, 'NaN', 'NaN', 'NaN'), (3, 0, 0, '-0', '-0'), (4, 16777217, 16777217, 16777216, 16777216);

query I rowsort
SELECT id FROM t1 WHERE n = d
----
0
1
2
3

query I rowsort
SELECT id FROM t1 WHERE NOT (n = d)
----
4

query I rowsort
SELECT id FROM t1 WHERE n > r
----
4

query I rowsort
SELECT id FROM t1 WHERE NOT (n > r)
----
0
1
2
3

query I rowsort
SELECT id FROM t1 WHERE i = r
----
3

query I rowsort
SELECT id FROM t1 WHERE NOT (i = r)
----
0
1
2
4

query I rowsort
SELECT id FROM t1 WHERE i < d
----
0
2

query I rowsort
SELECT id FROM t1 WHERE NOT (i < d)
----
1
3
4
