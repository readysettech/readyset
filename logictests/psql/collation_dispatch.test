# Per-column collation dispatch.
#
# A column declared `COLLATE "C"` must sort by raw byte order (matching
# Postgres's `C` / `POSIX` semantics), not by ICU root tertiary (which is
# Readyset's default for unqualified text columns).
#
# The data exercises a divergence: byte order interleaves uppercase and
# lowercase by ASCII codepoint, while ICU root tertiary sorts case-insensitive
# at the primary level and treats `-` as variable-weight.
#   byte order:        '-' (0x2D) < '0'..'9' (0x30..) < 'A'..'Z' (0x41..) < 'a'..'z' (0x61..)

statement ok
CREATE TABLE coll_c (
  id INT PRIMARY KEY,
  s  TEXT COLLATE "C"
)

statement ok
INSERT INTO coll_c VALUES
  (1, 'apple'),
  (2, 'Banana'),
  (3, 'apple-pie'),
  (4, 'applepie'),
  (5, 'BANANA-split'),
  (6, '-leading-dash'),
  (7, 'Apple')

query IT nosort
SELECT id, s FROM coll_c ORDER BY s
----
6
-leading-dash
7
Apple
5
BANANA-split
2
Banana
1
apple
3
apple-pie
4
applepie

# A column declared `COLLATE "en_US.utf8"` sorts like glibc, where spaces and
# punctuation only break ties between strings that otherwise compare equal.

statement ok
CREATE TABLE coll_en_us (
  id INT PRIMARY KEY,
  s  TEXT COLLATE "en_US.utf8"
)

statement ok
INSERT INTO coll_en_us VALUES
  (1, 'item 16 sneaker'),
  (2, 'item 1670 funko'),
  (3, 'item-17 pin'),
  (4, 'item_18 mug'),
  (5, 'Item 19 cap'),
  (6, 'item20 bag'),
  (7, 'a b'),
  (8, 'ab'),
  (9, 'a-c')

query IT nosort
SELECT id, s FROM coll_en_us ORDER BY s
----
7
a b
8
ab
9
a-c
2
item 1670 funko
1
item 16 sneaker
3
item-17 pin
4
item_18 mug
5
Item 19 cap
6
item20 bag
