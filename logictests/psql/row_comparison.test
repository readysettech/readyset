# Row comparisons: `(a, b) = ($1, $2)` is a lookup, any other comparison of two rows is a
# filter, and a row mixing a placeholder with other operands is unsupported.

statement ok
CREATE TABLE t (id int PRIMARY KEY, a text, b int, c text, d int)

statement ok
INSERT INTO t VALUES (1,'x',1,'x',1),(2,'x',2,'y',2),(3,'y',1,'y',1),(4,'z',3,'q',4),(5,'x',1,'x',2)

# Columns on both sides are compared as a filter.
query I rowsort
SELECT id FROM t WHERE (a, b) = (c, d)
----
1
3

# Non-equality comparisons are filters.
query I rowsort
SELECT id FROM t WHERE (a, b) != ('x', 1)
----
2
3
4

query I rowsort
SELECT id FROM t WHERE (a, b) < ('y', 1)
----
1
2
5

# An all-literal equality is a lookup.
query I rowsort
SELECT id FROM t WHERE (a, b) = ('x', 1)
----
1
5

# A row that stops satisfying the comparison leaves the result.
statement ok
UPDATE t SET d = 9 WHERE id = 3

query I rowsort
SELECT id FROM t WHERE (a, b) = (c, d)
----
1

# An ordering comparison resolves each position against the column on its left, so a numeric
# string compares as a number there just as it does in an equality.
query I rowsort
SELECT id FROM t WHERE (a, b) < ('y', '2')
----
1
2
3
5

# Unequal arity is an error.
statement error
SELECT id FROM t WHERE (a, b) != ('x', 1, 'z')

# Only a row of columns compared to literals is parameterized. A column among the literals keeps
# them inline, so the comparison caches as a filter.
statement ok
CREATE CACHE row_mixed FROM SELECT id FROM t WHERE (a, b) = ('x', d)

query I rowsort
SELECT id FROM t WHERE (a, b) = ('x', d)
----
1
2

# So does a literal among the columns, and the filter compares every position, the all-literal
# ones included.
statement ok
CREATE CACHE row_literal_left FROM SELECT count(*) FROM t WHERE ('', a) = ('A', 'x')

query I nosort
SELECT count(*) FROM t WHERE ('', a) = ('A', 'x')
----
0

query I rowsort
SELECT id FROM t WHERE (a, '') = ('x', '')
----
1
2
5

query I rowsort
SELECT id FROM t WHERE (a, '') IN (('x', ''), ('z', 'q'))
----
1
2
5

# A prepared row comparison binds one parameter per position.
query I rowsort
SELECT id FROM t WHERE (b, d) = ($1, $2)
$1 = 1
$2 = 1
----
1

# Placeholders on the left of a row of columns are turned around to face them, each still binding
# the column at its own position.
query I rowsort
SELECT id FROM t WHERE ($1, $2) = (b, d)
$1 = 1
$2 = 2
----
5

# A literal beside the placeholder is lifted, so the client binds one value and the pass supplies
# the other. The lifted one takes the position after the placeholder, not the placeholder's own.
query I rowsort
SELECT id FROM t WHERE (b, d) = ($1, 2)
$1 = 1
----
5

# A row comparison can be written with its literals on the left, and each position still
# resolves against whichever side carries the type. Resolving against the left alone leaves the
# literal untyped, and it then compares against the column as a value of another kind.
query I rowsort
SELECT id FROM t WHERE ('x', '2') > (a, b)
----
1
5

query I rowsort
SELECT id FROM t WHERE ('x', '1') = (a, b)
----
1
5

# Both sides can hold a column and a literal at once, and the position is what decides which of
# them carries the type: the left side supplies it at the first position and the right at the
# second.
query I rowsort
SELECT id FROM t WHERE (a, '0') < ('y', b)
----
1
2
3
5

# A projection reaches the comparison by a different path than a WHERE clause does, and resolves
# its positions the same way.
query IT nosort
SELECT id, (a, b) < (c, d) FROM t ORDER BY id
----
1
0
2
1
3
1
4
0
5
1

query IT nosort
SELECT id, ('x', '1') = (a, b) FROM t ORDER BY id
----
1
1
2
0
3
0
4
0
5
1
