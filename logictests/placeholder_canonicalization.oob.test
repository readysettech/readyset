# A cache created from a statement written with `?` serves the reads that spell the same query
# with literals, and one created from literals serves the reads that bind `?`. Out-of-band
# migration makes the pairing observable: a read is served only by a cache that canonicalized to
# the same form, and nothing is created on its behalf.

statement ok
CREATE TABLE authors (id int primary key, name text)

statement ok
CREATE TABLE books (id int primary key, author_id int, rating int)

statement ok
INSERT INTO authors (id, name) VALUES (1, 'ada'), (2, 'bob')

statement ok
INSERT INTO books (id, author_id, rating) VALUES (1, 1, 5), (2, 1, 5), (3, 2, 5), (4, 2, 3)

# A join, cached with `?` and read with a literal.
onlyif readyset
statement ok
CREATE CACHE FROM SELECT books.id FROM books JOIN authors ON books.author_id = authors.id WHERE books.rating = ?

query I rowsort
SELECT books.id FROM books JOIN authors ON books.author_id = authors.id WHERE books.rating = 5
----
1
2
3

# The same cache serves the read that binds the placeholder.
query I rowsort
SELECT books.id FROM books JOIN authors ON books.author_id = authors.id WHERE books.rating = ?
? = 5
----
1
2
3

# A HAVING over an aliased aggregate.
onlyif readyset
statement ok
CREATE CACHE FROM SELECT author_id, COUNT(*) AS c FROM books WHERE rating = ? GROUP BY author_id HAVING COUNT(*) > 1

query II nosort
SELECT author_id, COUNT(*) AS c FROM books WHERE rating = 5 GROUP BY author_id HAVING COUNT(*) > 1
----
1
2

# An IN subquery.
onlyif readyset
statement ok
CREATE CACHE FROM SELECT id FROM books WHERE author_id IN (SELECT id FROM authors WHERE name = ?)

query I rowsort
SELECT id FROM books WHERE author_id IN (SELECT id FROM authors WHERE name = 'ada')
----
1
2

# A derived table.
onlyif readyset
statement ok
CREATE CACHE FROM SELECT t.author_id, t.c FROM (SELECT author_id, COUNT(*) AS c FROM books GROUP BY author_id) t WHERE t.author_id = ?

query II nosort
SELECT t.author_id, t.c FROM (SELECT author_id, COUNT(*) AS c FROM books GROUP BY author_id) t WHERE t.author_id = 1
----
1
2

# The other way round: cached from literals, read with `?`.
onlyif readyset
statement ok
CREATE CACHE FROM SELECT books.id FROM books JOIN authors ON books.author_id = authors.id WHERE books.rating = 3 AND authors.name = 'bob'

query I rowsort
SELECT books.id FROM books JOIN authors ON books.author_id = authors.id WHERE books.rating = ? AND authors.name = ?
? = 3
? = bob
----
4

# A CTE, cached with `?` and read with a literal.
onlyif readyset
statement ok
CREATE CACHE FROM WITH per_author AS (SELECT author_id, COUNT(*) AS c FROM books GROUP BY author_id) SELECT per_author.author_id, per_author.c FROM per_author WHERE per_author.author_id = ?

query II nosort
WITH per_author AS (SELECT author_id, COUNT(*) AS c FROM books GROUP BY author_id) SELECT per_author.author_id, per_author.c FROM per_author WHERE per_author.author_id = 1
----
1
2
