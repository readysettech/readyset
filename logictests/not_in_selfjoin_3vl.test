# A NOT IN whose subquery reads a table already in the FROM decorrelates into an anti-join
# over that table.  Keeping the decorrelation is what keeps the 3VL probes: while the subquery
# survived instead, MIR lowered it on its own, without them, and the NULL in `t`.`x` went
# unseen.
#
# Under three-valued logic `x NOT IN (20, NULL)` is UNKNOWN for every x that does not equal 20,
# so the answer is empty while that NULL is present.  Removing it gives a non-empty answer,
# which is what makes the read after the write worth asserting: an empty expectation alone
# would also hold for a cache that returned nothing at all.

statement ok
create table t (id int primary key, x int);

statement ok
insert into t (id, x) values (1, 10), (2, 20), (3, NULL);

# Each side reads `t` through state decorrelation gives it rather than through the base, so the
# write reaches those states one at a time and the shape is admitted.
query I nosort
SELECT a.x FROM t AS a WHERE a.x NOT IN (SELECT b.x FROM t AS b WHERE b.id > 1) ORDER BY a.x;
----

# The hazard this pass exists for is a post-write one, so the admission is only worth anything
# if the cache still tracks upstream across a write.  Dropping the NULL row leaves the IN list
# as (20), so every row that is not 20 qualifies.
statement ok
delete from t where id = 3;

query I nosort
SELECT a.x FROM t AS a WHERE a.x NOT IN (SELECT b.x FROM t AS b WHERE b.id > 1) ORDER BY a.x;
----
10

# The same NULL situation over a separate table keeps its probes, caches, and answers
# empty.  This is the control: it fails if the probes stop being emitted at all.
statement ok
create table u (id int primary key, y int);

statement ok
insert into u (id, y) values (1, 99), (2, 20), (3, NULL);

query I nosort
SELECT a.x FROM t AS a WHERE a.x NOT IN (SELECT u.y FROM u WHERE u.id > 1) ORDER BY a.x;
----
