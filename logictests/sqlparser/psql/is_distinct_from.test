# `IS DISTINCT FROM` / `IS NOT DISTINCT FROM`: null-safe inequality and equality. Lives under
# sqlparser/ because only sqlparser parses the syntax.
#
# Each predicate is bracketed. sqlparser binds the operator's right operand with `parse_expr`
# (its lowest precedence), so an unbracketed `x IS DISTINCT FROM 1 AND ...` swallows the
# following conjunct.

statement ok
create table t (id int, a int, b int);

statement ok
insert into t values
  (1, 1, 1),
  (2, 1, 2),
  (3, null, null),
  (4, null, 1),
  (5, 1, null);

# Unlike `=`, both sides are null-safe: only rows 2, 4 and 5 differ.
query I rowsort
select id from t where a is distinct from b;
----
2
4
5

query I rowsort
select id from t where a is not distinct from b;
----
1
3

# `=` returns NULL where either side is NULL, so the null rows drop out entirely. This is the
# distinction the operator exists for.
query I rowsort
select id from t where a = b;
----
1

# Against a literal: NULL is distinct from a value, and a value is distinct from a different one.
query I rowsort
select id from t where a is distinct from 1;
----
3
4

query I rowsort
select id from t where a is not distinct from 1;
----
1
2
5

# Negation normalizes to the opposite operator rather than being rejected.
query I rowsort
select id from t where not (a is distinct from b);
----
1
3

# A conjunction of two of them: the bracketing keeps the second predicate out of the first
# operator's right operand.
query I rowsort
select id from t where (a is distinct from b) and (a is not distinct from 1);
----
2
5

# Composed with a JSON text extraction cast to boolean -- the shape that makes the operator
# worth having. A stored `false`, a stored JSON null and an absent key must all survive
# `IS DISTINCT FROM true`; only an explicit `true` is excluded. Reading the extraction as JSON
# rather than as text would make every present key read as true and silently drop rows 2 and 3.
statement ok
create table jf (id int, props json);

statement ok
insert into jf values
  (1, '{"flag": true}'),
  (2, '{"flag": false}'),
  (3, '{"flag": null}'),
  (4, '{"other": 1}');

query I rowsort
select id from jf where (props ->> 'flag')::boolean is distinct from true;
----
2
3
4

query I rowsort
select id from jf where (props ->> 'flag')::boolean is not distinct from true;
----
1

# Two such predicates in one WHERE, as the motivating query has them.
statement ok
create table jf2 (id int, props json);

statement ok
insert into jf2 values
  (1, '{"a": false, "b": false}'),
  (2, '{"a": true,  "b": false}'),
  (3, '{"a": false, "b": true}'),
  (4, '{}');

query I rowsort
select id from jf2
where ((props ->> 'a')::boolean is distinct from true)
  and ((props ->> 'b')::boolean is distinct from true);
----
1
4
