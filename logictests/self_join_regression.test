# The shapes the rule admits where each input stops at state of its own, read once before a
# write and again after.  Expected values checked against upstream.
statement ok
CREATE TABLE ts (id INT PRIMARY KEY, k INT, v INT)

statement ok
INSERT INTO ts VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30)

# A grouped count on each input: each group pairs with itself.
query I nosort
SELECT count(*) AS n FROM (SELECT k, count(*) AS c FROM ts GROUP BY k) a JOIN (SELECT k, count(*) AS c FROM ts GROUP BY k) b ON a.k = b.k
----
2

# A derived table carrying a literal column, which is the admission a cross join reaches
# through `add_bogokey_if_necessary`, written in SQL instead.  Every row pairs with every row.
query I nosort
SELECT count(*) AS n FROM (SELECT v, 1 AS lit FROM ts) a JOIN (SELECT v, 1 AS lit FROM ts) b ON a.lit = b.lit
----
9

# Top-k on each input: the two smallest, each pairing with itself.
query I nosort
SELECT count(*) AS n FROM (SELECT v FROM ts ORDER BY v LIMIT 2) a JOIN (SELECT v FROM ts ORDER BY v LIMIT 2) b ON a.v = b.v
----
2

statement ok
