# A parameterised cache over a shared base is refused like any other: the key is never read, so
# a placeholder changes nothing.
statement ok
CREATE TABLE users (id INT PRIMARY KEY, friend INT)

onlyif readyset
statement error: reaches both sides of a join
create cache fof from SELECT u1.id AS user, u2.friend AS fof FROM users u1 JOIN users u2 ON u1.friend = u2.id WHERE u1.id = ?

# And a cache whose own SQL never names the base table, reaching it only through two views.
statement ok
CREATE VIEW fof_a AS SELECT id, friend FROM users

statement ok
CREATE VIEW fof_b AS SELECT id, friend FROM users

onlyif readyset
statement error: reaches both sides of a join
create cache fof2 from SELECT a.id AS user, b.friend AS fof FROM fof_a a JOIN fof_b b ON a.friend = b.id
