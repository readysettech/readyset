# The equality lives in WHERE rather than ON, and the two sides reach different columns, so
# the AST detector does not apply.  `convert_filters_to_join_keys` relocates it before the MIR
# pass looks, which is what puts both inputs on one base with nothing between them.  Were it
# left in WHERE the join would stay keyless, `add_bogokey_if_necessary` would give each input a
# literal projection to stop at, and the shape would be admitted like the cross joins below.
query  nosort error: Base\ table\ t\ reaches\ both\ sides\ of\ a\ join
SELECT count(*) AS n FROM t, (SELECT t.column_1 AS ax FROM t) AS a WHERE t.column_4 = a.ax
----
0

# A cross join over one base table reaches the pass with no key of its own:
# `add_bogokey_if_necessary` gives it a constant one, and the literal-carrying projection that
# carries it is what each lookup stops at.  The write reaches those two projections one at a
# time, so each pair is emitted once and the query caches.
query II nosort
SELECT a.column_4 AS x, b.column_4 AS y FROM t AS a, t AS b WHERE a.column_4 = 4 AND b.column_4 = 5
----
4
5

# An inequality is a filter above the join rather than a key, so this arrives carrying the
# same constant key a cross join does and caches for the same reason.
query II nosort
SELECT a.column_4 AS x, b.column_4 AS y FROM t AS a JOIN t AS b ON a.column_4 < b.column_4 WHERE a.column_4 = 5
----
5
6

# The two admitting cases above read once from a cache built on the then-current rows, so
# they cannot observe the hazard this pass exists to refuse.  These repeat them with a write
# after the cache exists and with no filter excluding the diagonal pair, which is the pair a
# double-count would duplicate.  Three rows survive the deletes above, five after the insert.
query I nosort
SELECT count(*) AS n FROM t AS a, t AS b
----
9

query I nosort
SELECT count(*) AS n FROM t AS a JOIN t AS b ON a.column_4 < b.column_4
----
3

