# The shape the rule admits with a join in the stop position on both sides: two views, each
# joining the shared base to a second table, joined to each other on the key they share.  A
# lookup from either input resolves at that view's own join rather than at `t`, so the write
# reaches the two of them one at a time.  Reaching this from one statement takes views: a FROM
# subquery carrying only a join is inlined, which flattens it onto the base.
statement ok
CREATE TABLE u2 (id INT PRIMARY KEY, k INT)

statement ok
INSERT INTO u2 (id, k) VALUES (1, 1)

statement ok
CREATE VIEW va AS SELECT t.column_1 AS k, t.column_4 AS v FROM t JOIN u2 ON t.column_1 = u2.k

statement ok
CREATE VIEW vb AS SELECT t.column_1 AS k, t.column_4 AS v FROM t JOIN u2 ON t.column_1 = u2.k

# Five rows of `t` carry column_1 = 1 and so reach both views, pairing twenty-five ways.
query I nosort
SELECT count(*) AS n FROM va AS a JOIN vb AS b ON a.k = b.k
----
25

# A row landing on the key the join set already holds: the pair it makes with itself must be
# emitted once, so this is thirty-six and not more.
statement ok
INSERT INTO t (column_1, column_4, column_2, column_3) VALUES (1, 9, 1, 1)

query I nosort
SELECT count(*) AS n FROM va AS a JOIN vb AS b ON a.k = b.k
----
36

statement ok
DELETE FROM t WHERE (column_4 = 9)

query I nosort
SELECT count(*) AS n FROM va AS a JOIN vb AS b ON a.k = b.k
----
25

# A write that moves a key rather than only a payload: this row leaves both views, since `u2`
# holds no k = 2.
statement ok
UPDATE t SET column_1 = 2 WHERE (column_4 = 4)

query I nosort
SELECT count(*) AS n FROM va AS a JOIN vb AS b ON a.k = b.k
----
16

# The shape glutton draws as its race sentinel: one base reached through a `DISTINCT` on each
# side.  Each lookup resolves at its own aggregate, so the write reaches them one at a time.
# `column_4` is the primary key, so the `DISTINCT` changes no row -- which is what lets the
# sentinel keep witnessing key presence while staying cacheable.
query I nosort
SELECT count(*) AS n FROM (SELECT DISTINCT column_4 FROM t) AS j0
  JOIN (SELECT DISTINCT column_4 FROM t) AS j1 ON j0.column_4 = j1.column_4
----
5

statement ok
INSERT INTO t (column_1, column_4, column_2, column_3) VALUES (2, 10, 1, 1)

query I nosort
SELECT count(*) AS n FROM (SELECT DISTINCT column_4 FROM t) AS j0
  JOIN (SELECT DISTINCT column_4 FROM t) AS j1 ON j0.column_4 = j1.column_4
----
6

# MIN and MAX on each side of a join over one shared base.  `Extremum` is the one aggregate that
# reads back into its parent: retracting the current extreme leaves it with no value to fold the
# delta into, so it looks the group up in the base and recomputes.  That read is not what the rule
# reasons about -- the rule asks where a lookup from the join comes to rest -- so these pin the
# interaction rather than the rule.  Both caches live over the same base at once.
statement ok
CREATE TABLE tg (id INT PRIMARY KEY, k INT, v INT)

statement ok
INSERT INTO tg (id, k, v) VALUES (1, 1, 10), (2, 1, 20), (3, 2, 30), (4, 2, 40)

query II nosort
SELECT a.m AS am, b.m AS bm FROM (SELECT k, MIN(v) AS m FROM tg GROUP BY k) AS a JOIN (SELECT k, MIN(v) AS m FROM tg GROUP BY k) AS b ON a.k = b.k ORDER BY a.k
----
10
10
30
30

query II nosort
SELECT a.m AS am, b.m AS bm FROM (SELECT k, MAX(v) AS m FROM tg GROUP BY k) AS a JOIN (SELECT k, MAX(v) AS m FROM tg GROUP BY k) AS b ON a.k = b.k ORDER BY a.k
----
20
20
40
40

# Retracting the minimum of the first group: the read-back path for MIN, an ordinary fold for MAX.
