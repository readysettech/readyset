# A parameter on a join key prepares whatever name the view gives that column.

statement ok
CREATE TABLE orders (id int PRIMARY KEY, user_id int, total int)

statement ok
CREATE TABLE users (id int PRIMARY KEY, name text)

statement ok
INSERT INTO users VALUES (1, 'ann'), (2, 'bob'), (3, 'cat')

statement ok
INSERT INTO orders VALUES (10, 1, 5), (11, 2, 7), (12, 2, 9), (13, 3, 4)

query TI rowsort
SELECT users.name AS who, users.id AS uid FROM orders INNER JOIN users ON orders.user_id = users.id WHERE users.id = ?
? = 2
----
bob
2
bob
2

query TI rowsort
SELECT users.name AS who, users.id AS uid FROM orders INNER JOIN users ON orders.user_id = users.id WHERE users.id IN (?, ?)
? = 1
? = 3
----
ann
1
cat
3

query TI rowsort
SELECT users.name AS who, users.id AS uid FROM orders INNER JOIN users ON orders.user_id = users.id WHERE users.id > ?
? = 1
----
bob
2
bob
2
cat
3

# The join's kept side, which the view names directly.
query II rowsort
SELECT orders.user_id AS uid, orders.total AS total FROM orders INNER JOIN users ON orders.user_id = users.id WHERE orders.user_id = ?
? = 2
----
2
7
2
9

# Both sides projected.
query II rowsort
SELECT orders.user_id AS a, users.id AS b FROM orders INNER JOIN users ON orders.user_id = users.id WHERE users.id = ?
? = 3
----
3
3

# Grouped on the key.
query II rowsort
SELECT users.id AS uid, count(*) AS n FROM orders INNER JOIN users ON orders.user_id = users.id WHERE users.id = ? GROUP BY users.id
? = 2
----
2
2
