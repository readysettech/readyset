# A write to the join side that holds the view key misses in the join and evicts
# Paginate's group. The reader's (group, page) entries must be evicted with it.

statement ok
create table j1 (grp int, val int);

statement ok
create table j2 (grp2 int, val int);

statement ok
insert into j1 (grp, val) values (1, 1), (1, 2), (1, 3), (1, 4), (1, 5), (1, 6);

statement ok
insert into j2 (grp2, val) values (1, 1), (1, 2), (1, 3);

statement ok
create cache from select j1.val from j1 join j2 on j1.val = j2.val where grp2 = $1 order by val asc limit 2 offset 2;

query I nosort
select j1.val from j1 join j2 on j1.val = j2.val where grp2 = $1 order by val asc limit 2 offset 2
$1 = 1
----
3

statement ok
insert into j2 (grp2, val) values (1, 4);

query I nosort
select j1.val from j1 join j2 on j1.val = j2.val where grp2 = $1 order by val asc limit 2 offset 2
$1 = 1
----
3
4
