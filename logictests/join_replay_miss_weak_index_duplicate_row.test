# A new row of `a` must not join a deleted row of `b`. The cache materializes the join of `b` and
# the COUNT, which the outer join reads by `b.k` when `a` changes. Reading `g = 1` replays `b` rows
# 1 and 2 into that join, misses on row 2 at the COUNT's hole for `y = 2`, and replays again, which
# must leave row 1 there once. Row 1 of `b` is stored twice (no primary key); a new row of `a` must
# join each stored copy exactly once.

statement ok
CREATE TABLE a (id int PRIMARY KEY, x int)

statement ok
CREATE TABLE b (id int, g int, k int, x int)

statement ok
CREATE TABLE c (id int PRIMARY KEY, y int)

statement ok
INSERT INTO c (id, y) VALUES (1, 1), (2, 2)

statement ok
INSERT INTO b (id, g, k, x) VALUES (1, 1, 1, 1), (1, 1, 1, 1), (2, 1, 1, 2), (3, 2, 3, 1)

statement ok
INSERT INTO a (id, x) VALUES (1, 1), (2, 3)

onlyif readyset
statement ok
CREATE CACHE FROM SELECT a.id, b.id FROM a JOIN b ON a.x = b.k
JOIN (SELECT y, count(*) AS n FROM c GROUP BY y) cc ON b.x = cc.y WHERE b.g = ?

# Fills the COUNT at `y = 1` only.
query II rowsort
SELECT a.id, b.id FROM a JOIN b ON a.x = b.k
JOIN (SELECT y, count(*) AS n FROM c GROUP BY y) cc ON b.x = cc.y WHERE b.g = ?
? = 2
----
2
3

